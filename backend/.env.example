# Copy this file to .env and fill in values as needed.
# No paid API keys are required anywhere in this project.

# Override any Settings field from app/config.py here, e.g.:
# RETRIEVAL_TOP_K=10

# --- NCBI E-utilities (used by app/ingestion/pmc_scraper.py and pubmed_client.py) ---
# NCBI_EMAIL should be a real address you control — required by NCBI's usage
# policy so they can contact you if a script misbehaves.
# NCBI_EMAIL=you@example.com

# Optional but recommended: a free NCBI API key raises the eutils rate limit
# from 3 req/sec to 10 req/sec (pubmed_client.py detects it automatically).
# Get one at https://www.ncbi.nlm.nih.gov/account/ (free account) -> Account
# Settings -> "API Key Management" -> Create an API Key. Everything in this
# project works without one, just slower.
# NCBI_API_KEY=

# --- Stance classifier (see README: Model Provenance) ---
# "zeroshot" (default) needs no checkpoint. "finetuned" requires one at
# STANCE_MODEL_PATH and fails at startup if it is missing.
# STANCE_MODEL_MODE=zeroshot
# STANCE_MODEL_PATH=models/stance-deberta
